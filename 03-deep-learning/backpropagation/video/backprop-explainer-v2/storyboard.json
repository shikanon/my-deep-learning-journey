    {
      "id": "s01",
      "title": "参数那么多，怎样一起算？",
      "kind": "hook",
      "start": 0,
      "end": 12.701478996884953,
      "question": "为什么一遍反传能得到多个参数的梯度？",
      "steps": [
        {
          "id": "many",
          "cue": "上亿个参数",
          "start": 1.0695982313166277,
          "meaning": "参数共同进入一次模型计算",
          "duration": 0.8774,
          "frame_start": 32,
          "frame_end": 58
        },
        {
          "id": "trial",
          "cue": "逐个拧一下",
          "start": 2.239471296819189,
          "meaning": "逐个试探需要重复运行模型",
          "duration": 1.15,
          "frame_start": 67,
          "frame_end": 102
        },
        {
          "id": "reuse",
          "cue": "反着走一遍",
          "start": 6.183614774799254,
          "meaning": "沿共同计算的原路径返回多个梯度",
          "duration": 1.15,
          "frame_start": 186,
          "frame_end": 220
        },
        {
          "id": "example",
          "cue": "一道能手算的小题",
          "start": 9.659809026578294,
          "meaning": "缩小为两个参数，接着亲手计算",
          "duration": 1.15,
          "frame_start": 290,
          "frame_end": 324
        }
      ]
    },
    {
      "id": "s02",
      "title": "前向：把数值算出来",
